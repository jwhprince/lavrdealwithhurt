# Set before build. Rebuild after changing public/site/legal/analytics settings.
SITE_URL=
INDEXABLE=false
LEADS_ENABLED=false
LEGAL_APPROVED=false

# Only real, approved details. Empty optional fields are omitted from the site.
CONTACT_PHONE=
CONTACT_EMAIL=
SOCIAL_VK=
SOCIAL_TELEGRAM=
LEGAL_OPERATOR=
LEGAL_INN=
LEGAL_ADDRESS=
PRIVACY_EMAIL=
# Approved retention period, written as a complete phrase in Russian.
LEGAL_RETENTION=

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
LEADS_EMAIL=
# True ONLY when the reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=false

YANDEX_VERIFICATION=
METRIKA_ENABLED=false
METRIKA_ID=
